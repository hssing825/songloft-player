/android/app/release

.aone_copilot/
dist/
pubspec.lock

# 嵌入桌面客户端的 Go 后端二进制（由 make build-go-desktop-* 构建，不入库）
/macos/Runner/songloft-server
/windows/runner/songloft-server.exe
/linux/runner/songloft-server
/ios/Songloft.xcframework
/android/app/libs/*.aar

# WebF 验证容器的截图与日志产物（songloft-org/songloft#341）
/scripts/webf-verify/out/

# Xcode / Swift Package Manager 本地状态
# xcshareddata/swiftpm/ 未追踪但 Xcode 会自动创建。
# pbxproj / Podfile.lock / xcscheme 是工程定义与可复现构建的必需文件，
# 必须入库（删掉曾导致 CI 无法构建 iOS，见 73d60a6）。
**/xcshareddata/swiftpm/
